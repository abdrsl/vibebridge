# VibeBridge Configuration
# Copy to ~/.config/vibebridge/config.yaml

# ============================================
# Feishu Bot Configuration
# ============================================

feishu:
  mode: websocket  # "websocket" | "webhook"
  app_id: "${FEISHU_APP_ID}"
  app_secret: "${FEISHU_APP_SECRET}"
  encrypt_key: "${FEISHU_ENCRYPT_KEY}"
  verification_token: "${FEISHU_VERIFICATION_TOKEN}"

  # Multi-bot support (optional)
  bots:
    - agent: "default"
      app_id: "${FEISHU_APP_ID}"
      app_secret: "${FEISHU_APP_SECRET}"
      encrypt_key: "${FEISHU_ENCRYPT_KEY}"
      verification_token: "${FEISHU_VERIFICATION_TOKEN}"
      enabled: true

# ============================================
# AI Provider Configuration
# ============================================

agents:
  default_provider: opencode

  opencode:
    enabled: true
    binary: auto
    model: deepseek/deepseek-chat
    default_workdir: ~/workspace

  kimi:
    enabled: false
    acp_url: http://127.0.0.1:9876

  claude:
    enabled: false
    binary: auto

  openrouter:
    enabled: false
    api_key: "${OPENROUTER_API_KEY}"
    default_model: openai/gpt-4o

# ============================================
# Redis Configuration (for Agent Bridge)
# ============================================

redis:
  enabled: true
  host: localhost
  port: 6379
  password: "${REDIS_PASSWORD}"

# ============================================
# Approval Configuration
# ============================================

approval:
  enabled: false

# ============================================
# Logging
# ============================================

logging:
  level: INFO
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# ============================================
# Usage
# ============================================
#
# 1. Copy to ~/.config/vibebridge/config.yaml
# 2. Set environment variables in .env:
#    FEISHU_APP_ID=cli_xxx
#    FEISHU_APP_SECRET=xxx
#    FEISHU_ENCRYPT_KEY=xxx
#    FEISHU_VERIFICATION_TOKEN=xxx
#    REDIS_PASSWORD=xxx (optional)
#    OPENROUTER_API_KEY=xxx (optional)
# 3. Start: vibebridge start
# 4. Check: vibebridge status
